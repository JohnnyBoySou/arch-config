#!/bin/sh
# Recarrega o Hyprland, a menubar (Waybar) e a dock (nwg-dock-hyprland).
# Os dois scripts de arranque já matam a instância anterior antes de subir.
"$HOME/.local/bin/waybar-start" >/dev/null 2>&1 &
"$HOME/.local/bin/dock-start" >/dev/null 2>&1 &
hyprctl reload >/dev/null 2>&1
echo "Recarregado."
