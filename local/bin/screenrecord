#!/usr/bin/env bash
# Gravação de tela estilo macOS: toggle liga/desliga, salva em ~/Vídeos,
# copia o caminho para o clipboard e notifica ao terminar.
# uso: screenrecord region|full [--audio]
set -uo pipefail

modo="${1:-region}"
audio=""
[[ "${2:-}" == "--audio" ]] && audio="-a"

dir="$HOME/Vídeos"
estado="/tmp/screenrecord.atual"

# --- se já está gravando, esta invocação apenas para a gravação ---
if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder
    arquivo="$(cat "$estado" 2>/dev/null)"
    rm -f "$estado"

    # espera o wf-recorder fechar o container (senão o mp4 fica corrompido)
    for _ in {1..50}; do
        pgrep -x wf-recorder >/dev/null || break
        sleep 0.1
    done

    [[ -z "$arquivo" || ! -f "$arquivo" ]] && exit 0
    wl-copy < <(printf '%s' "$arquivo")

    acao="$(notify-send -a "Gravação de tela" -i video-x-generic \
            -A "abrir=Abrir" -A "pasta=Mostrar na pasta" \
            "Gravação salva" "$(basename "$arquivo")")"
    case "$acao" in
        abrir) xdg-open "$arquivo" ;;
        pasta) xdg-open "$dir" ;;
    esac
    exit 0
fi

# --- caso contrário, inicia uma nova gravação ---
command -v wf-recorder >/dev/null || {
    notify-send -a "Gravação de tela" -u critical \
        "wf-recorder não instalado" "sudo pacman -S wf-recorder"
    exit 1
}

mkdir -p "$dir"
arquivo="$dir/Gravacao-$(date +%Y%m%d-%H%M%S).mp4"

case "$modo" in
    region)
        # borda vermelha distingue a seleção de gravação da de print
        geo="$(slurp -c ff453aff -b 00000040 -w 2)" || exit 0   # Esc cancela
        set -- -g "$geo"
        ;;
    full)
        set --
        ;;
    *)
        echo "uso: screenrecord region|full [--audio]" >&2; exit 2
        ;;
esac

printf '%s' "$arquivo" > "$estado"
notify-send -a "Gravação de tela" -i media-record -t 2000 \
    "Gravando…" "Pressione o mesmo atalho para parar"

# setsid: solta o wf-recorder do process group do script, senão ele
# recebe SIGHUP e morre assim que esta invocação termina
setsid -f wf-recorder $audio "$@" -f "$arquivo" >/dev/null 2>&1
