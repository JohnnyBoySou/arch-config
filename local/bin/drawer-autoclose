#!/usr/bin/env python3
"""Fecha o Launchpad (nwg-drawer) quando o foco sai dele.

O nwg-drawer é uma layer-surface: ela não pertence a nenhum workspace e o
Hyprland não a esconde ao trocar de área de trabalho nem ao clicar numa
janela. Então escutamos o socket de eventos do compositor e mandamos
`nwg-drawer -close` nos eventos que significam "o usuário foi para outro lugar".
"""

import os
import socket
import subprocess
import sys

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
SIG = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")

if not SIG:
    # sem a assinatura da instância não dá para achar o socket
    hypr = f"{RUNTIME}/hypr"
    candidatos = sorted(os.listdir(hypr), key=lambda d: os.path.getmtime(f"{hypr}/{d}"))
    if not candidatos:
        sys.exit("Hyprland não está rodando")
    SIG = candidatos[-1]

SOCKET = f"{RUNTIME}/hypr/{SIG}/.socket2.sock"

# Eventos que devem dispensar o drawer.
FECHAR = ("workspace>>", "focusedmon>>", "activespecial>>", "openwindow>>")


def residente_vivo() -> bool:
    """Ha uma instancia `nwg-drawer -r` de pe?

    `pgrep -x nwg-drawer` sozinho nao serve: casa tambem os clientes efemeros
    `-open`/`-close`. E `pgrep -f` casaria qualquer processo que mencione a
    string. Entao: nome exato, e destes os que tem `-r` como argumento proprio.
    """
    listagem = subprocess.run(
        ["pgrep", "-x", "nwg-drawer"],
        capture_output=True,
        text=True,
        check=False,
    )
    for pid in listagem.stdout.split():
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as arquivo:
                if b"-r" in arquivo.read().split(b"\0"):
                    return True
        except OSError:
            continue
    return False


def fechar():
    # Sem residente, `nwg-drawer -close` nao fecha nada: sobe um drawer proprio
    # e o mostra. Um evento qualquer viraria um Launchpad aberto do nada, e a
    # cada tentativa de fechar aparecia outro.
    if not residente_vivo():
        return
    subprocess.run(
        ["nwg-drawer", "-close"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


sock = socket.socket(socket.AF_UNIX)
sock.connect(SOCKET)

buffer = b""
while True:
    pedaco = sock.recv(4096)
    if not pedaco:
        break
    buffer += pedaco
    while b"\n" in buffer:
        linha, buffer = buffer.split(b"\n", 1)
        evento = linha.decode(errors="replace")

        if evento.startswith(FECHAR):
            fechar()
        elif evento.startswith("activewindow>>"):
            # Ao ganhar foco de teclado, o drawer emite `activewindow>>,` (vazio)
            # porque nenhuma janela fica ativa — ignorar, senão ele se fecharia
            # no instante em que abre. Só fecha quando uma janela real assume.
            if evento[len("activewindow>>"):].strip(","):
                fechar()
