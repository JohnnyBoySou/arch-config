#!/usr/bin/env python3
"""Manda a janela ativa para a gaveta (workspace 5), lembrando de onde veio."""
import json, subprocess, sys, os

DRAWER = 5
STATE = os.path.expanduser("~/.cache/hypr-minimized.json")

def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout

def load():
    try:
        with open(STATE) as f: return json.load(f)
    except Exception:
        return {}

def save(d):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f: json.dump(d, f)
    os.replace(tmp, STATE)

win = json.loads(hypr("activewindow", "-j") or "{}")
addr = win.get("address")
if not addr:
    sys.exit(0)

ws = win.get("workspace", {})
# já está na gaveta: não faz nada
if ws.get("id") == DRAWER:
    sys.exit(0)

origem = ws.get("id")
if origem is None or origem < 0:
    origem = 1

state = load()
state[addr] = origem
save(state)

hypr("dispatch", "movetoworkspacesilent", f"{DRAWER},address:{addr}")
